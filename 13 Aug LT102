class Solution:
    def levelOrder(self, root):
        if root == None:
            return []
        q = [root]
        res = []
        while q:
            sz = len(q)
            level = []
            for i in range(len(q)):
                node = q.pop(0)
                level.append(node.val)
                if node.left:
                    q.append(node.left)
                if node.right:
                    q.append(node.right)
            res.append(level)
        return res
