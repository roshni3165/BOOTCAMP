class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        sum=0
        count=0
        hashmap={0:1}
        for i in nums:
            sum+=i
            if sum-k in hashmap:
                count+=hashmap[sum-k]
            hashmap[sum]=hashmap.get(sum,0)+1
        return count
