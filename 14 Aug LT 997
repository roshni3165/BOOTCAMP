class Solution:
    def findJudge(self, n, trust):
        trust_count = [0] * (n + 1)
        trusts_someone = [False] * (n + 1)

        for a, b in trust:
            trusts_someone[a] = True
            trust_count[b] += 1

        for person in range(1, n + 1):
            if not trusts_someone[person] and trust_count[person] == n - 1:
                return person

        return -1
